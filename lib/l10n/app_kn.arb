  "faq2q": "ಸೈನೋವಾಯ್ಸ್ ನನ್ನ ವೀಡಿಯೊವನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆಯೇ?",
  "faq2a": "ಇಲ್ಲ. ವೀಡಿಯೊವನ್ನು ಕೈ ಸ್ಥಾನಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ವಿಶ್ಲೇಷಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಎಂದಿಗೂ ರೆಕಾರ್ಡ್ ಅಥವಾ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ.",
  "faq3q": "ಉಚಿತ ಟ್ರಯಲ್ ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ?",
  "faq3a": "ಹೊಸ ಖಾತೆಗಳು ಒಂದು ತಿಂಗಳ ಉಚಿತ ಟ್ರಯಲ್ ಪ್ರಾರಂಭಿಸಬಹುದು. ಅದು ಮುಗಿಯುವ ಮೊದಲು ನೀವು Google Play ನಲ್ಲಿ ರದ್ದುಗೊಳಿಸದಿದ್ದರೆ ತೋರಿಸಿದ ಬೆಲೆಯಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕರಣವಾಗುತ್ತದೆ.",
  "faq4q": "ನನ್ನ ಚಂದಾದಾರಿಕೆಯನ್ನು ಹೇಗೆ ರದ್ದುಗೊಳಿಸಲಿ?",
  "faq4a": "Google Play ತೆರೆಯಿರಿ › ಪಾವತಿಗಳು ಮತ್ತು ಚಂದಾದಾರಿಕೆಗಳು › ಚಂದಾದಾರಿಕೆಗಳು › SignoVoice › ಚಂದಾದಾರಿಕೆ ರದ್ದುಮಾಡಿ.",
  "faq5q": "ನಾನು ಸೈನೋವಾಯ್ಸ್ ಅನ್ನು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಬಳಸಬಹುದೇ?",
  "faq5a": "ಹೌದು, ಸಾಧನದ ಸಂಜ್ಞೆ ಗುರುತಿಸುವಿಕೆ, ನಿಘಂಟು ಮತ್ತು ಪಾಠಗಳಿಗೆ. ಲೈವ್ ದುಭಾಷಿಗಳು, ಆನ್‌ಲೈನ್ ಗುರುತಿಸುವಿಕೆ ಮತ್ತು ಎಐ ಅನುವಾದಕ್ಕೆ ಇಂಟರ್ನೆಟ್ ಬೇಕು.",
  "faq6q": "ಕೆಲವು ಸಂಜ್ಞೆಗಳಿಗೆ ವೀಡಿಯೊ ಏಕೆ ಇಲ್ಲ?",
  "faq6a": "ನಮ್ಮ ಬಳಿ ವೀಡಿಯೊ ಇರುವುದಕ್ಕಿಂತ ಹೆಚ್ಚು ಸಂಜ್ಞೆಗಳನ್ನು ನಿಘಂಟು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ. ವೀಡಿಯೊಗಳನ್ನು ಕಾಲಕ್ರಮೇಣ ಸೇರಿಸಲಾಗುತ್ತದೆ.",
