<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied to cloud backups or device-to-device transfers: history, progress and the
     encrypted sign-in/subscription cache stay on this device (matches the privacy policy). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
